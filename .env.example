SECRET_KEY=замените-на-длинную-случайную-строку
BASE_URL=http://localhost:8010
TIMEZONE=Europe/Moscow

# локальный запуск без docker (в compose эти значения переопределяются)
DATABASE_URL=postgresql+asyncpg://prospace:prospace@localhost:5433/prospace
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
SMTP_HOST=localhost
SMTP_PORT=1025

# ИИ-агент модерации заказов (опционально)
AI_MODERATION_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=claude-opus-5-5
